{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tech4humanity.com/schemas/goose/recipe-catalogue.schema.json",
  "title": "T4H Recipe Catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "recipes"],
  "properties": {
    "version": {"const": "1.2.0"},
    "recipes": {
      "type": "array",
      "minItems": 15,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(agents|core|development|evidence|jobs|review|subrecipes|tasks|workers)/.+\\.yaml$"}
    }
  }
}
