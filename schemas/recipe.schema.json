{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tech4humanity.com/schemas/goose/recipe.schema.json",
  "title": "T4H Goose Recipe",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "title", "description", "instructions", "prompt", "settings"],
  "properties": {
    "version": {"type": "string", "pattern": "^1\\.2\\.0$"},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "input_type", "requirement", "description"],
        "properties": {
          "key": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "input_type": {"enum": ["string", "number", "boolean"]},
          "requirement": {"enum": ["required", "optional"]},
          "description": {"type": "string", "minLength": 1},
          "default": {}
        }
      }
    },
    "sub_recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "description", "values"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "path": {"type": "string", "pattern": "^\\.\\./"},
          "description": {"type": "string", "minLength": 1},
          "values": {"type": "object", "minProperties": 1},
          "sequential_when_repeated": {"type": "boolean"}
        }
      }
    },
    "instructions": {"type": "string", "minLength": 1},
    "prompt": {"type": "string", "minLength": 1},
    "extensions": {"type": "array", "items": {"type": "object"}},
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_turns"],
      "properties": {"max_turns": {"type": "integer", "minimum": 1, "maximum": 500}}
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_retries", "timeout_seconds", "backoff_seconds", "recovery"],
      "properties": {
        "max_retries": {"type": "integer", "minimum": 0, "maximum": 10},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "backoff_seconds": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "recovery": {"type": "string", "minLength": 1},
        "checks": {"type": "array", "items": {"type": "object"}}
      }
    }
  }
}
