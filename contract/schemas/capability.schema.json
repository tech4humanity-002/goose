{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tech4humanity.com/schemas/agent-contract/capability.schema.json",
  "title": "T4H Model Capability Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "capabilities"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "contract_version": {"const": "1.4.0"},
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "controls"],
        "properties": {
          "description": {"type": "string", "minLength": 1},
          "controls": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
