{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tech4humanity.com/schemas/agent-contract/platform-profile.schema.json",
  "title": "T4H Model Platform Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "id", "provider", "role", "sdk", "authentication", "capability_bindings", "boundaries", "mutable_facts"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "contract_version": {"const": "1.4.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "provider": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "sdk": {
      "type": "object",
      "required": ["python_package", "version_policy", "legacy_packages"],
      "properties": {
        "python_package": {"type": "string", "minLength": 1},
        "version_policy": {"const": "latest-compatible"},
        "legacy_packages": {"type": "array", "items": {"type": "string"}}
      }
    },
    "authentication": {"type": "object", "required": ["environment_variable", "rules"]},
    "capability_bindings": {"type": "object", "minProperties": 1},
    "boundaries": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "mutable_facts": {
      "type": "object",
      "required": ["checked_at", "review_due", "refresh_before_use", "sources"],
      "properties": {
        "checked_at": {"type": "string", "format": "date"},
        "review_due": {"type": "string", "format": "date"},
        "refresh_before_use": {"const": true},
        "sources": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "format": "uri"}}
      }
    }
  }
}
