{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tech4humanity.com/schemas/goose/result.schema.json",
  "title": "T4H Structured Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation_id", "recipe_id", "status", "result", "evidence", "gaps", "next_action", "confidence", "started_at", "completed_at"],
  "properties": {
    "schema_version": {"const": "1.2.0"},
    "operation_id": {"type": "string", "minLength": 1},
    "recipe_id": {"type": "string", "pattern": "^t4h-[a-z0-9-]+$"},
    "status": {"enum": ["REAL", "PARTIAL", "BLOCKED", "DEGRADED", "QUARANTINED", "ASPIRATIONAL"]},
    "result": {},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "gaps": {"type": "array", "items": {"type": "string"}},
    "next_action": {"type": ["string", "null"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"}
  }
}
